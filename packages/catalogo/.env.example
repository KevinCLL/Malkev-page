# Conexión a PostgreSQL (la del docker-compose por defecto)
DATABASE_URL=postgres://malkevnia:malkevnia@localhost:5432/malkevnia
PORT=4400
# Carpeta donde se guardan las imágenes subidas desde el panel
UPLOADS_DIR=./uploads
# Orígenes que pueden llamar a la API pública desde el navegador (separados por comas)
CORS_ORIGINS=http://localhost:4321,http://localhost:3000
# Autocompletado: TMDB necesita clave gratuita (v3 o token v4). BGG puede pedir token.
TMDB_API_KEY=
BGG_TOKEN=
# Contraseña inicial del capitán (solo se usa si aún no existe la cuenta)
ADMIN_USER=capitan
ADMIN_PASSWORD=
# Secreto para firmar los tokens de comentarios (si falta, se genera uno y se guarda en la base de datos)
APP_SECRET=
# Proxies de confianza para leer la IP real (por defecto: loopback y redes privadas, como la de Docker)
TRUST_PROXY=
# Otros orígenes desde los que se puede usar el panel, si no se sirve en el mismo dominio que la API
APP_ORIGINS=
