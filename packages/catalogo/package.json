{
  "name": "@malkevnia/catalogo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Malkevnia: base de datos PostgreSQL del catálogo (juegos, pelis, libros, manga) y del blog, con API y panel de administración.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "capitan": "node --env-file-if-exists=.env scripts/capitan.js",
    "dev": "node --env-file-if-exists=.env server/index.js --dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "marked": "^16.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/vue-3": "^3.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  }
}
