# Copia este fichero a .env y rellena lo que tengas. Todo es opcional.

# Clave gratuita de TMDB (https://www.themoviedb.org/settings/api). Vale la "API Key" (v3)
# o el "API Read Access Token" (v4, empieza por eyJ). Sin ella, las pelis y series se exportan
# sin enriquecer y quedan marcadas como pendientes.
# TMDB_API_KEY=

# Idioma de los títulos y sinopsis de TMDB (es-ES por defecto).
# TMDB_IDIOMA=es-ES

# Carpeta de la caché de respuestas de las APIs (cache/ por defecto).
# IMPORTADORES_CACHE=
