# Copia este fichero a .env (en poc/) y rellena lo que uses. Todo es opcional.

# Puerto del servidor (5173 si no se indica).
PORT=5173

# Contraseña inicial de la consola. Solo se usa si todavía no hay ninguna; después se cambia desde la
# propia consola (o con npm run consola:clave) y esta línea se puede borrar.
# ADMIN_PASSWORD=

# Pon 1 si la web se sirve por HTTPS (la cookie de sesión solo viajará cifrada).
# COOKIE_SECURE=0

# Carpeta de la base de datos, las imágenes subidas y las copias (poc/data/ si no se indica).
# DATA_DIR=

# Claves del botón "Buscar" de la consola.
# TMDB_API_KEY=
# BGG_TOKEN=
