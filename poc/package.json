{
  "name": "malkevnia-poc",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Malkevnia: la bitácora con base de datos y los hobbies como estancias de una nave, en Vue + SQLite local.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "seed": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/seed.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js --prod",
    "copia": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/copia.js",
    "consola:clave": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/consola-clave.js",
    "build:demo": "node scripts/build-demo.js",
    "kallax:lista": "node scripts/kallax-lista.js kallax-inventario.md",
    "import:goodreads": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/import-goodreads.js",
    "import:goodreads-web": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/import-goodreads-web.js",
    "import:anilist": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/import-anilist.js",
    "import:filmaffinity": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/import-filmaffinity.js",
    "import:launchbox": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/import-launchbox.js",
    "coleccion:export": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/coleccion-export.js",
    "coleccion:import": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/coleccion-import.js"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/vue-3": "^3.31.4",
    "express": "^5.2.1",
    "marked": "^18.1.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "vite": "^8.3.3"
  }
}
