# Copia este fichero a .env y rellena los valores.
# Sin DATABASE_URL la web arranca igual: la bitácora lee el módulo modulos/bitacora/posts.json
# y las salas de colección se muestran vacías.
DATABASE_URL=postgres://malkevnia:cambia-esto@localhost:5432/malkevnia

# Solo para docker-compose
POSTGRES_PASSWORD=cambia-esto
# Puerto local donde escucha la web (el proxy inverso del servidor apunta aquí)
WEB_PORT=4321
SITE_URL=https://malkevnia.com

# API del catálogo (packages/catalogo, PR #4). Si está definida, la bitácora sale de ahí.
# En el servidor: http://catalogo:4400/api/v1 por la red interna de Docker.
# CATALOGO_API_URL=http://localhost:4400/api/v1

# Solo con docker-compose.catalogo.yml
# ADMIN_USER=capitan
# ADMIN_PASSWORD=
# TMDB_API_KEY=
# CATALOGO_PORT=4400
