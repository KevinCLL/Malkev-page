---
import Nave from '../layouts/Nave.astro';
import { sala as buscarSala } from '../lib/salas';
import { moduloMontable } from '../lib/modulos';

/**
 * Esqueleto común de una sala. Si el módulo de la sala ya existe en `modulos/`,
 * lo monta a pantalla completa; si no, enseña un marcador y lo que haya en el slot
 * (contenido provisional servido desde Astro).
 */
interface Props { slug: string }
const s = buscarSala(Astro.props.slug);
const montado = moduloMontable(s.modulo);
---
{montado ? (
  <Nave titulo={s.nombre} descripcion={s.resumen} sala={s.slug} inmersivo>
    <iframe class="modulo" src={`/modulos/${s.modulo}/index.html`} title={s.nombre} allow="fullscreen; gyroscope; accelerometer; autoplay"></iframe>
    <a class="volver panel" href="/">◂ Puente</a>
  </Nave>
) : (
  <Nave titulo={s.nombre} descripcion={s.resumen} sala={s.slug}>
    <section class="cabecera">
      <p class="etiqueta">{s.cubierta} · {s.slug}</p>
      <h1><span aria-hidden="true">{s.icono}</span> {s.nombre}</h1>
      <p class="resumen">{s.resumen}</p>
    </section>
    <slot />
    {s.modulo && (
      <aside class="obras panel">
        <p class="etiqueta">Sala en obras</p>
        <p>
          Esta sala se llenará con el módulo <code>{s.modulo}</code>. En cuanto exista{' '}
          <code>modulos/{s.modulo}/index.html</code>, aparecerá aquí a pantalla completa.
        </p>
      </aside>
    )}
  </Nave>
)}

<style>
  .modulo { position: fixed; inset: 0; width: 100%; height: 100%; border: 0; display: block; z-index: 1; }
  .volver { position: fixed; z-index: 2; right: max(16px, env(safe-area-inset-right, 0px)); bottom: calc(16px + env(safe-area-inset-bottom, 0px)); padding: 8px 14px; color: var(--text); text-decoration: none; font: 600 13px var(--f-mono); }
  .cabecera h1 { font-size: clamp(28px, 5vw, 44px); margin: 6px 0 8px; }
  .resumen { color: var(--muted); max-width: 60ch; margin: 0 0 28px; }
  .obras { margin-top: 32px; padding: 16px 18px; border-style: dashed; }
  .obras p { margin: 0 0 6px; }
  .obras p:last-child { color: var(--muted); }
  code { font-family: var(--f-mono); font-size: 0.88em; color: var(--glow); }
</style>
