---
import Nave from '../layouts/Nave.astro';
import { ruta, traductor } from '../i18n';

const idioma = Astro.locals.idioma ?? 'es';
const t = traductor(idioma);
---
<Nave titulo={t('Sector desconocido')} traducida={false} noindex>
  <p class="etiqueta">{t('Error 404')}</p>
  <h1>{t('Este sector no aparece en las cartas')}</h1>
  <p>{t('La ruta que buscas no existe en La Malkevnia.')} <a href={ruta(idioma, '/')}>{t('Vuelve al puente')}</a>.</p>
</Nave>
