---
import Nave from '../layouts/Nave.astro';
import { salas } from '../lib/salas';
import { montaje } from '../lib/modulos';
import { listarEntradas, resolverUrlAntigua } from '../lib/bitacora';
import { fechas, ruta, traductor } from '../i18n';
import { persona, sitioWeb } from '../lib/datos-estructurados';

// Enlaces de la época de WordPress (/?p=1038): la API del catálogo conoce sus alias.
if (Astro.url.searchParams.has('p')) {
  const slug = await resolverUrlAntigua(`/?p=${Astro.url.searchParams.get('p')}/`);
  return Astro.redirect(slug ? `/bitacora/${encodeURIComponent(slug)}` : '/bitacora', 301);
}

const idioma = Astro.locals.idioma;
const t = traductor(idioma);
// La consola es solo para el capitán: no sale en el panel de salas.
const destinos = salas.filter((s) => !['puente', 'consola'].includes(s.slug));
const operativa = (s: (typeof salas)[number]) => s.slug === 'bitacora' || montaje(s) !== null;
const ultimas = (await listarEntradas()).slice(0, 3);
const fmt = fechas(idioma, { dateStyle: 'long' });
const descripcion = t('La web de Malkev convertida en nave espacial: la bitácora del capitán, juegos de mesa, cine, libros y un universo entero para explorar sin prisa.');
const site = Astro.site ?? new URL('https://malkevnia.com');
---
<Nave titulo="La Malkevnia" descripcion={descripcion} sala="puente" datos={[sitioWeb(site, idioma, descripcion), persona(site)]}>
  <section class="puente">
    <p class="etiqueta">{t('Cubierta 1 · puente de mando')}</p>
    <h1>{t('Bienvenido a bordo')}</h1>
    <p class="intro">
      {t('La Malkevnia surca el espacio sin prisa. Aquí dentro están la bitácora del capitán, las Kallax llenas de juegos, la filmoteca y la biblioteca. Elige una sala.')}
    </p>
  </section>

  <section aria-labelledby="t-salas">
    <h2 id="t-salas" class="etiqueta">{t('Salas de la nave')}</h2>
    <ul class="rejilla">
      {destinos.map((s) => (
        <li>
          <a class="tarjeta panel" href={ruta(idioma, s.ruta)}>
            <span class="icono" aria-hidden="true">{s.icono}</span>
            <span class="nombre">{t(s.nombre)}</span>
            <span class="txt">{t(s.resumen)}</span>
            <span class="estado" data-listo={operativa(s)}>{operativa(s) ? t('Operativa') : t('En obras')}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {ultimas.length > 0 && (
    <section aria-labelledby="t-ultimas" class="ultimas">
      <h2 id="t-ultimas" class="etiqueta">{t('Últimas entradas de la bitácora')}</h2>
      <ul>
        {ultimas.map((e) => (
          <li>
            <a href={ruta(idioma, `/bitacora/${e.slug}`)} lang="es">{e.titulo}</a>
            <time datetime={e.fecha.toISOString()}>{fmt.format(e.fecha)}</time>
          </li>
        ))}
      </ul>
    </section>
  )}
</Nave>

<style>
  .puente h1 { font-size: clamp(32px, 6vw, 56px); margin: 8px 0 12px; }
  .intro { color: var(--muted); max-width: 62ch; margin: 0 0 40px; font-size: 18px; }
  .rejilla { list-style: none; padding: 0; margin: 12px 0 48px; display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); }
  .tarjeta { display: grid; gap: 6px; height: 100%; padding: 18px; color: var(--text); text-decoration: none; transition: border-color 0.2s, transform 0.2s; }
  .tarjeta:hover { border-color: var(--accent); transform: translateY(-2px); color: var(--text); }
  .icono { font-size: 22px; color: var(--glow); }
  .nombre { font: 600 16px var(--f-display); letter-spacing: 0.03em; }
  .txt { color: var(--muted); font-size: 14px; line-height: 1.5; }
  .estado { justify-self: start; margin-top: 6px; font: 600 10px var(--f-mono); letter-spacing: 0.16em; text-transform: uppercase; padding: 3px 8px; border-radius: 99px; border: 1px solid var(--line); color: var(--muted); }
  .estado[data-listo='true'] { color: #9ff0c4; border-color: rgba(159, 240, 196, 0.4); }
  .ultimas ul { list-style: none; padding: 0; margin: 12px 0 0; }
  .ultimas li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .ultimas time { color: var(--muted); font: 13px var(--f-mono); }
</style>
